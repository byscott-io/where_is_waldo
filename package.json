{
  "name": "@byscott-io/where-is-waldo",
  "version": "0.1.10",
  "description": "Real-time presence tracking for ActionCable with React hooks",
  "main": "dist/index.js",
  "module": "dist/index.esm.js",
  "files": [
    "dist",
    "src",
    "!**/*.test.js",
    "!**/*.test.jsx"
  ],
  "scripts": {
    "build": "rollup -c",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src",
    "lint:fix": "eslint src --fix",
    "prepublishOnly": "npm run build",
    "cypress:open": "cypress open",
    "cypress:run": "cypress run",
    "server": "cd spec/dummy && RAILS_ENV=development bundle exec puma -p 3001",
    "server:setup": "cd spec/dummy && RAILS_ENV=development bundle exec rake db:create db:migrate",
    "test:e2e": "start-server-and-test server http://localhost:3001 cypress:run",
    "test:e2e:open": "start-server-and-test server http://localhost:3001 cypress:open"
  },
  "peerDependencies": {
    "@rails/actioncable": "^7.0.0 || ^8.0.0",
    "react": "^17.0.0 || ^18.0.0 || ^19.0.0"
  },
  "devDependencies": {
    "@byscott-io/eslint-config": "^0.2.0",
    "@rails/actioncable": "^8.1.301",
    "@rollup/plugin-commonjs": "^29.0.3",
    "@rollup/plugin-node-resolve": "^16.0.3",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.3",
    "cypress": "^15.21.0",
    "esbuild": "^0.28.2",
    "eslint": "^10.9.1",
    "jsdom": "^30.0.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "rollup": "^4.63.0",
    "rollup-plugin-esbuild": "^6.2.1",
    "start-server-and-test": "^3.0.12",
    "vitest": "^4.1.11"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/byscott-io/where_is_waldo.git"
  },
  "keywords": [
    "actioncable",
    "presence",
    "websocket",
    "react",
    "rails",
    "real-time"
  ],
  "author": "Scott Gibson",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/byscott-io/where_is_waldo/issues"
  },
  "homepage": "https://github.com/byscott-io/where_is_waldo#readme",
  "publishConfig": {
    "registry": "https://registry.npmjs.org",
    "access": "public"
  },
  "resolutions": {
    "axios": "^1.18.0",
    "js-yaml": "^4.3.1",
    "postcss": "^8.5.26",
    "qs": "^6.15.2",
    "undici": "^7.29.0",
    "systeminformation": "^5.31.17"
  }
}
