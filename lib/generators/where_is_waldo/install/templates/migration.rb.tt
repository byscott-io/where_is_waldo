# frozen_string_literal: true

class CreatePresences < ActiveRecord::Migration<%= migration_version %>
  def change
    create_table :presences do |t|
      t.string :<%= session_column %>, null: false
      t.references :<%= subject_column.sub(/_id$/, '') %>, null: false, foreign_key: true
      t.datetime :connected_at, null: false
      t.datetime :last_heartbeat, null: false
      t.datetime :last_activity
      t.boolean :tab_visible, default: true, null: false
      t.boolean :subject_active, default: true, null: false
      t.<%= json_column_type %> :metadata
      t.timestamps
    end

    # (subject, session) must be unique TOGETHER, never session alone. Session
    # ids are not globally unique -- they are client-supplied in some setups,
    # and a reused JWT jti is enough -- so keying on the session alone lets two
    # authenticated subjects upsert onto each other's presence row. This is the
    # keying the adapter uses: every session lookup scopes by both columns.
    add_index :presences, [ :<%= subject_column %>, :<%= session_column %> ], unique: true
    add_index :presences, :last_heartbeat
  end
end
